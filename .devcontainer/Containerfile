# Containerfile — reproducible build env for egg (egg).
# Builds with rootless Podman (`podman build`) or Docker; identical format.
#
# Base: debian:trixie-slim. Toolchain is LLVM 21 from trixie-backports; the only
# thing compiled from source is AdaptiveCpp (acpp), built against that LLVM 21
# (there is no prebuilt acpp image, and acpp must match its LLVM).
#
# GPU backends are opt-in build args (CPU/OpenMP + generic SSCP JIT always on):
#   WITH_CUDA=1   AdaptiveCpp CUDA (NVIDIA) backend + CUDA toolkit + container toolkit
#   WITH_ROCM=1   AdaptiveCpp ROCm/HIP (AMD) backend + userspace ROCm (AMD repo)
#
#   podman build -t egg-dev .devcontainer                          # CPU
#   podman build --build-arg WITH_ROCM=1 -t egg-rocm .devcontainer # +AMD
#   podman build --build-arg WITH_CUDA=1 -t egg-cuda .devcontainer # +NVIDIA

FROM debian:trixie-slim

ARG WITH_ROCM=0
ARG WITH_CUDA=0
# AdaptiveCpp git ref (tag, branch, or commit SHA). Pinned to a commit because
# even v25.10.0 fails to compile against LLVM 21; this SHA has the LLVM 21 fixes.
# CANONICAL VALUE: /ACPP_VERSION at the repo root (also read by CMakeLists.txt
# for the superbuild). Keep this default in sync with that file.
ARG ACPP_VERSION=54c31cd
# NVIDIA CUDA apt repo + packages (versioned). Only used with WITH_CUDA=1.
ARG CUDA_REPO_DEBIAN=debian13
# Minimal set for acpp's CUDA backend, NOT the full `cuda-toolkit-13-3`
# meta-package (~6.3 GB: cuBLAS/cuFFT/Nsight/samples/docs, none of which the
# generic-SSCP backend uses). acpp JITs PTX via its own LLVM, so no nvcc codegen;
# nvcc is kept only because find_package(CUDAToolkit) may require a compiler
# component. Validate on a `cuda`/`all` build; add specific packages if CMake
# complains rather than reverting to the meta-package.
ARG CUDA_TOOLKIT_PKG="cuda-cudart-dev-13-3 cuda-driver-dev-13-3 cuda-nvcc-13-3"
# ROCm version from AMD's repo.radeon.com (Debian 13 uses the `noble` codename
# per AMD docs). Only used with WITH_ROCM=1.
ARG ROCM_VERSION=7.2.4
# Minimal set for acpp's ROCm/HIP backend, NOT the full `rocm` meta-package
# (~6.8 GB: rocBLAS/Tensile/MIOpen/FFT/profilers, none of which the generic-SSCP
# backend uses). HIP runtime + HSA/ROCr + comgr + device libs are what the
# backend builds/finalizes against. ROCm apt names shift between versions —
# validate on a `rocm`/`all` build at ROCM_VERSION and add specific packages if
# find_package(hip)/HSA/comgr fails, rather than reverting to `rocm`.
ARG ROCM_PKGS="rocm-core hip-dev hsa-rocr-dev comgr rocm-device-libs"
ARG UV_VERSION=0.11.19

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    ROCM_PATH=/opt/rocm \
    CUDA_HOME=/usr/local/cuda \
    PATH=/opt/adaptivecpp/bin:/usr/lib/llvm-21/bin:/opt/rocm/bin:/usr/local/cuda/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# trixie-backports for the LLVM 21 toolchain + cmake (+ rocm-podman-support).
RUN echo 'deb http://deb.debian.org/debian trixie-backports main contrib non-free non-free-firmware' \
        > /etc/apt/sources.list.d/backports.list

# Base tools + LLVM 21 toolchain. The *-dev libs (llvm/clang/lld) are pulled in
# addition to the requested runtime packages because acpp links against them to
# build its clang-based SSCP compiler.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates git curl wget gnupg \
        build-essential mold ccache \
        libboost-context-dev libboost-fiber-dev \
        python3 python3-dev python3-setuptools python3-wheel python-is-python3 \
    && apt-get install -y --no-install-recommends -t trixie-backports \
        cmake ninja-build \
        llvm-21 llvm-21-dev \
        clang-21 clangd-21 clang-format-21 clang-tools-21 clang-tidy-21 \
        libclang-21-dev libclang-cpp21-dev libclang-common-21-dev \
        libclang-rt-21-dev \
        lld-21 liblld-21-dev \
        libomp5 libomp-21-dev \
    && rm -rf /var/lib/apt/lists/*

# ROCm / HIP (AMD) — AMD's official repo (repo.radeon.com), per the ROCm Debian
# install docs. Installs userspace ROCm under /opt/rocm (ROCM_PATH); the amdgpu
# kernel driver and amd-container-toolkit (the GPU device injector) live on the
# HOST, not here. Debian 13 uses the `noble` codename per AMD docs.
RUN if [ "$WITH_ROCM" = "1" ]; then \
        mkdir -p --mode=0755 /etc/apt/keyrings \
        && wget -qO- https://repo.radeon.com/rocm/rocm.gpg.key \
             | gpg --dearmor -o /etc/apt/keyrings/rocm.gpg \
        && printf 'deb [arch=amd64 signed-by=/etc/apt/keyrings/rocm.gpg] https://repo.radeon.com/rocm/apt/%s noble main\ndeb [arch=amd64 signed-by=/etc/apt/keyrings/rocm.gpg] https://repo.radeon.com/graphics/%s/ubuntu noble main\n' "$ROCM_VERSION" "$ROCM_VERSION" \
             > /etc/apt/sources.list.d/rocm.list \
        && printf 'Package: *\nPin: release o=repo.radeon.com\nPin-Priority: 600\n' \
             > /etc/apt/preferences.d/rocm-pin-600 \
        && apt-get update \
        && apt-get install -y --no-install-recommends ${ROCM_PKGS} \
        && rm -rf /var/lib/apt/lists/* ; \
    fi

# CUDA (NVIDIA) — CUDA toolkit (nvcc/headers/libs) from NVIDIA's official apt
# repo, for acpp's CUDA backend. The NVIDIA Container Toolkit and driver are
# HOST prerequisites (they inject the GPU + driver libs at container start via
# CDI) — not installed here.
RUN if [ "$WITH_CUDA" = "1" ]; then \
        curl -fsSLO https://developer.download.nvidia.com/compute/cuda/repos/${CUDA_REPO_DEBIAN}/x86_64/cuda-keyring_1.1-1_all.deb \
        && dpkg -i cuda-keyring_1.1-1_all.deb && rm -f cuda-keyring_1.1-1_all.deb \
        && apt-get update \
        && apt-get install -y --no-install-recommends ${CUDA_TOOLKIT_PKG} \
        && rm -rf /var/lib/apt/lists/* ; \
    fi

# AdaptiveCpp (acpp) — the one source build, against LLVM 21, built with clang-21.
# Generic SSCP compiler always on so acpp JITs to whatever device is visible.
RUN git clone --filter=blob:none \
        https://github.com/AdaptiveCpp/AdaptiveCpp.git /tmp/acpp \
    && git -C /tmp/acpp checkout --detach ${ACPP_VERSION} \
    && cmake -S /tmp/acpp -B /tmp/acpp/build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/opt/adaptivecpp \
        -DCMAKE_C_COMPILER=clang-21 -DCMAKE_CXX_COMPILER=clang++-21 \
        -DLLVM_DIR=/usr/lib/llvm-21/lib/cmake/llvm \
        -DClang_DIR=/usr/lib/llvm-21/lib/cmake/clang \
        -DWITH_SSCP_COMPILER=ON \
        -DWITH_ACCELERATED_CPU=ON \
        -DWITH_CPU_BACKEND=ON \
        -DWITH_CUDA_BACKEND=$( [ "$WITH_CUDA" = "1" ] && echo ON || echo OFF ) \
        -DWITH_ROCM_BACKEND=$( [ "$WITH_ROCM" = "1" ] && echo ON || echo OFF ) \
        $( [ "$WITH_ROCM" = "1" ] && echo -DROCM_PATH=/usr ) \
    && cmake --build /tmp/acpp/build --target install \
    && rm -rf /tmp/acpp

# uv (pinned) — manages the Python 3.13 venv + locked project deps. Installed to
# /usr/local/bin (a world-accessible PATH dir) rather than the default
# ~/.local/bin: rootless keep-id runs the container as the host user, who can't
# traverse root's 0700 home, so a uv under /root/.local/bin is invisible to them.
RUN curl -LsSf https://astral.sh/uv/${UV_VERSION}/install.sh \
      | env UV_INSTALL_DIR=/usr/local/bin INSTALLER_NO_MODIFY_PATH=1 sh

# Interactive shell: zsh + starship, plus the vim and neovim editors. Shell
# defaults are baked as templates and seeded into $HOME on first run (by
# seed-home, called from podman-run.sh / postCreateCommand). $HOME is the
# persistent .devcontainer/.home, so the seeded files land there: visible and
# editable.
#   /etc/skel/.zshrc          Default .zshrc: Debian's maintainer-recommended
#                             config (what zsh-newuser-install writes on first
#                             run) plus `eval "$(starship init zsh)"`.
#   seed-home                 Copies /etc/skel/.zshrc to $HOME/.zshrc and writes
#                             the starship `pure` preset to
#                             $HOME/.config/starship.toml (starship's default
#                             config path). Only fills in files that are missing.
# Seeding a .zshrc also stops zsh's setup wizard (it prompts on an empty $HOME).
# Editing/removing the seeded files gives full control: drop the starship line to
# turn it off, or edit starship.toml to restyle the prompt.
RUN apt-get update \
    && apt-get install -y --no-install-recommends zsh starship vim neovim \
    && rm -rf /var/lib/apt/lists/* \
    && sed -e '/^# Set up the prompt$/d' \
           -e '/^autoload -Uz promptinit$/d' \
           -e '/^promptinit$/d' \
           -e '/^prompt adam1$/d' \
           /etc/zsh/newuser.zshrc.recommended > /etc/skel/.zshrc \
    && printf '%s\n' '' \
        '# Starship prompt. (The recommended config'\''s adam1 prompt theme is' \
        '# stripped above: starship cannot take over an active prompt theme.)' \
        'eval "$(starship init zsh)"' \
        >> /etc/skel/.zshrc \
    && printf '%s\n' \
        '#!/bin/sh' \
        '# Seed the persistent $HOME with default dotfiles on first use.' \
        'mkdir -p "$HOME/.config"' \
        '[ -e "$HOME/.zshrc" ] || cp /etc/skel/.zshrc "$HOME/.zshrc"' \
        '[ -e "$HOME/.config/starship.toml" ] || starship preset pure-preset -o "$HOME/.config/starship.toml"' \
        > /usr/local/bin/seed-home \
    && chmod +x /usr/local/bin/seed-home

# GUI examples (PyVista/VTK + matplotlib). OpenGL via mesa: the DRI package holds
# BOTH the hardware driver (radeonsi etc.) and the software fallback (llvmpipe),
# so the same image renders on the host GPU when /dev/dri is shared (podman-run.sh)
# and on llvmpipe otherwise. The kernel driver stays on the host. Also: GLX/EGL,
# the X11 + Wayland client libs VTK/Tk dlopen, and Tk for matplotlib's backend.
# mesa-utils ships glxinfo/glxgears to verify the renderer (hardware vs llvmpipe).
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libgl1 libglx-mesa0 libgl1-mesa-dri libglu1-mesa \
        libegl1 libegl-mesa0 libgbm1 libgles2 \
        libx11-6 libxext6 libxrender1 libxt6 libxcursor1 libxi6 \
        libxrandr2 libxfixes3 libxss1 libsm6 libice6 libxkbcommon0 \
        libwayland-client0 libwayland-egl1 libwayland-cursor0 \
        python3-tk mesa-utils \
    && rm -rf /var/lib/apt/lists/*

# Native desktop app (egg-desktop): the `pywebview[qt]` backend is PyQt6 +
# QtWebEngine wheels (Qt libs and ICU are bundled in the wheel), but those libs
# dlopen a set of system libraries that aren't covered by the mesa/X11 block
# above. Without them `import PyQt6.QtCore` fails and pywebview reports
# "No Qt bindings could be found". Two groups:
#   - Qt xcb platform plugin: the libxcb-* family (cursor is required by Qt 6.5+),
#     xkbcommon-x11, glib, dbus, fontconfig + a base font so text renders.
#   - QtWebEngine (Chromium): NSS/NSPR (not bundled), ALSA, and Xcomposite/
#     Xdamage/Xtst.
# The t64 names (libglib2.0-0t64, libasound2t64) are trixie's 64-bit-time_t
# packages. Validate by running `uv run egg-desktop`.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libglib2.0-0t64 libdbus-1-3 libexpat1 libudev1 \
        libfontconfig1 libfreetype6 fonts-dejavu-core \
        libx11-xcb1 libxkbcommon-x11-0 libxkbfile1 \
        libxcb-cursor0 libxcb-icccm4 libxcb-image0 libxcb-keysyms1 \
        libxcb-randr0 libxcb-render0 libxcb-render-util0 libxcb-shape0 \
        libxcb-shm0 libxcb-sync1 libxcb-util1 libxcb-xfixes0 libxcb-xkb1 \
        libxcb-dri3-0 \
        libnss3 libnspr4 libasound2t64 \
        libxcomposite1 libxdamage1 libxtst6 \
    && rm -rf /var/lib/apt/lists/*

# Docs: `uv run --group docs sphinx-build` pulls sphinx/breathe from the docs
# dependency group, but conf.py shells out to the `doxygen` binary up front to
# regenerate the C++ XML for Breathe (HAVE_DOT=NO, so graphviz isn't needed).
RUN apt-get update \
    && apt-get install -y --no-install-recommends doxygen \
    && rm -rf /var/lib/apt/lists/*

# egg-prewarm: compile AdaptiveCpp's SSCP kernels into its on-disk JIT cache
# before any GUI runs. The generic-SSCP JIT uses libLLVM in-process; if it fires
# while mesa's libLLVM is loaded for rendering (--plot-live), the two collide and
# segfault. Warming up front (no mesa loaded) sidesteps it. Called at container
# start (podman-run.sh / postCreateCommand); re-runs only when cpp_core changes.
RUN printf '%s\n' \
    '#!/bin/sh' \
    '# Pre-warm the AdaptiveCpp JIT cache before any GUI (avoids a libLLVM clash' \
    '# with mesa during --plot-live). Re-runs when the C++ extension changes.' \
    'so=$(ls -t .venv/lib/python3.13/site-packages/egg/_cpp/cpp_core*.so 2>/dev/null | head -n1)' \
    '[ -n "$so" ] || exit 0' \
    'stamp="$HOME/.egg-prewarm.stamp"' \
    '# Skip only if already warmed and cpp_core has not changed since.' \
    'if [ -e "$stamp" ] && [ ! "$so" -nt "$stamp" ]; then exit 0; fi' \
    'echo ">> Pre-warming AdaptiveCpp JIT cache (one-time per build) ..."' \
    'uv run examples/circles/untangle.py >/dev/null 2>&1 || true' \
    'touch "$stamp"' \
    > /usr/local/bin/egg-prewarm \
    && chmod +x /usr/local/bin/egg-prewarm

# Default the host C/C++ compiler to clang-21, matching the LLVM that acpp is
# built with. One toolchain for the project's non-SYCL TUs and acpp's SYCL TUs:
# consistent diagnostics/clang-tidy, and host<->device LTO possible. CMake reads
# CC/CXX when it configures a fresh build dir (delete build/ to switch an old one).
ENV UV_LINK_MODE=copy \
    CMAKE_PREFIX_PATH=/opt/adaptivecpp \
    CC=clang-21 \
    CXX=clang++-21 \
    SHELL=/usr/bin/zsh

WORKDIR /egg-workspace
CMD ["/bin/zsh"]
