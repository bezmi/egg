# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# C++ build artifacts
build/
.cpm_cache/
egg/_cpp/*.so
compile_commands.json

# Editor / tool caches
.cache/

# Local-only state (not part of the project)
.bash_history
.claude/

# Persistent devcontainer $HOME (shell state + your personal dotfiles)
.devcontainer/.home/
docs/_build/
docs/_doxygen/

# fasthtml session key (webui prototype, created at runtime)
.sesskey

# web UI assets generated at build time (tools/vendor_webui.py); never committed
egg/webui/static/vendor/
egg/webui/docs/
